# QuickWay Ride Environment Configuration Template

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Authentication & Database Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Maps & Places API Keys
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Nodemailer + Gmail SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="quickwayride@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="QuickWay Ride <quickwayride@gmail.com>"

# Upstash Redis & Rate Limiting Configuration
UPSTASH_REDIS_REST_URL="https://your-redis-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-rest-token"
